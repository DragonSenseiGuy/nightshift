#!/bin/sh
#
# NightShift server-side ref restriction.
#
# Install this in the *remote* repository (see README.md, "Deploy key setup"). It is the
# lock that actually holds: `gitops.push_branch` also refuses non-agent refnames, but that
# check runs on the machine holding the key, so it protects against our own bugs and not
# against a compromised host. This hook runs on the server, where the compromised host
# cannot edit it.
#
# Policy: a push authenticated as the NightShift deploy key may only create or update
# branches under refs/heads/agent/, and may never delete one. Everything else is rejected,
# including tags, notes and any other ref namespace.
#
# Scoping to the key: GitHub/GitLab deploy keys cannot run a custom pre-receive hook on a
# normal plan, so on those hosts the equivalent is a branch-protection / push-rule that
# restricts the key to `agent/*`. On a self-hosted bare repo (which is what the test suite
# exercises) this hook is the whole mechanism. When the remote is shared with human
# pushers, gate the policy on the authenticated user, e.g.:
#
#     [ "$GL_USERNAME" = "nightshift" ] || exit 0
#
# stdin: one line per ref update — "<old-sha> <new-sha> <refname>".

ALLOWED_PREFIX='refs/heads/agent/'
ZERO='0000000000000000000000000000000000000000'

status=0

while read -r oldrev newrev refname; do
    case "$refname" in
        "$ALLOWED_PREFIX"*)
            # Refuse deletions even inside the allowed namespace: a night's work is
            # evidence, and the agent has no business removing it.
            if [ "$newrev" = "$ZERO" ]; then
                echo "NightShift policy: refusing to delete $refname." >&2
                status=1
                continue
            fi
            # `..` cannot appear in a valid refname, but reject it loudly anyway rather
            # than trusting the client that just asked us to trust it.
            case "$refname" in
                *..*)
                    echo "NightShift policy: malformed refname $refname." >&2
                    status=1
                    ;;
            esac
            ;;
        *)
            echo "NightShift policy: $refname is outside $ALLOWED_PREFIX; rejected." >&2
            echo "  The nightly agent may only push agent/* branches. Merging into a" >&2
            echo "  protected branch happens after human review, never from a push." >&2
            status=1
            ;;
    esac
done

exit $status
